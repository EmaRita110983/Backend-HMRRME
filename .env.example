APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Solo para desarrollo: permite que el superadmin borre pacientes/historial/recetas/citas/usuarios.
# En producción debe quedar en false (o quitarse la variable).
SUPERADMIN_CAN_DELETE=false

# Minutos hasta que un token de Sanctum expira (ver config/sanctum.php).
# Default 20160 = 14 días. Un token robado o filtrado no debe quedar
# válido para siempre.
SANCTUM_TOKEN_EXPIRATION_MINUTES=20160

# Nota: la password de todo médico (role=admin) recién creado por el
# superadmin ya no sale de una variable de entorno fija — se genera aleatoria
# y única por usuario en UserController::store (antes era un valor
# compartido, DEFAULT_ADMIN_PASSWORD, versionado acá mismo y por lo tanto
# adivinable por cualquiera con acceso al repo). El médico debe cambiarla
# obligatoriamente en su primer login (ver AuthController::funCambiarPassword).

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres tanto en desarrollo como en producción a propósito (ver
# CLAUDE.md): evita discrepancias de tipos/sintaxis entre lo que se prueba
# localmente y lo que corre en producción. En desarrollo, un contenedor
# Docker local alcanza (ver CLAUDE.md para el comando exacto).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=inv_cv_laravel
DB_USERNAME=laravel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disco donde se guardan los estudios médicos subidos (rayos X, laboratorios,
# etc). "local" alcanza con un solo servidor; pasar a "s3" (con las AWS_*
# de más abajo) es necesario si se escala a más de un servidor de app.
MEDICAL_FILES_DISK=local
QUEUE_CONNECTION=database

# Orígenes adicionales permitidos por CORS, separados por coma (sin espacios).
# http://localhost:5173 ya está permitido siempre (ver config/cors.php).
# En producción, el dominio real del frontend (ej. Vercel) va acá.
# Ejemplo: CORS_ALLOWED_ORIGINS=https://mi-app.vercel.app,https://mi-dominio.com
CORS_ALLOWED_ORIGINS=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
