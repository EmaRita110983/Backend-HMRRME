# Plantilla de referencia para producción. No reemplaza a .env.example (que
# sigue siendo el de desarrollo) — copiá los valores que apliquen a tu .env
# real de producción según la plataforma que elijas (Railway, Render, VPS...).
# Todos estos cambios ya están soportados por el código sin tocar nada más;
# lo único que falta es que provisiones cada servicio y pegues sus
# credenciales acá.

APP_NAME="Nombre real de la app"
APP_ENV=production
APP_KEY=                      # generar con: php artisan key:generate --show
APP_DEBUG=false                # nunca true en producción: expone stack traces con rutas del servidor
APP_URL=https://api.tu-dominio.com

# --- Base de datos: Postgres, igual que en desarrollo (decisión explícita
# para evitar discrepancias entre lo que se prueba local y lo que corre en
# producción — ver CLAUDE.md). Railway/Render lo ofrecen administrado de
# forma nativa. Nunca SQLite en producción: serializa escrituras (un solo
# escritor a la vez) y no tiene un story de réplica/backup comparable. ---
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sesiones, caché y colas sobre Redis, no sobre la base de datos ---
# Con SESSION_DRIVER/CACHE_STORE/QUEUE_CONNECTION=database, cada login y
# cada request autenticada le pega a la misma base de datos que sirve el
# resto de la app. Redis lo descarga de ahí y responde mucho más rápido
# bajo carga concurrente.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true     # solo se envía la cookie por HTTPS
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis            # cliente PHP puro (ya en composer.json), no necesita la extensión phpredis compilada en el servidor
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Archivos médicos: local sirve con un solo servidor de app; pasar a s3
# cuando se necesite escalar a más de uno (el código ya soporta el cambio,
# ver EstudioMedico::getArchivoUrlAttribute) ---
MEDICAL_FILES_DISK=local       # cambiar a "s3" + completar AWS_* de abajo cuando aplique
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# --- CORS: dominio real donde vive el frontend (Vercel u otro) ---
# Sin esto, el navegador bloquea toda petición del frontend en producción
# aunque el backend funcione perfectamente.
CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app

# --- Logs: a stdout/stderr, no a un archivo local ---
# La mayoría de las plataformas administradas (Railway, Render, Docker en
# general) capturan stdout/stderr como los logs de la aplicación; escribir a
# storage/logs/laravel.log en un contenedor efímero pierde el historial en
# cada redeploy.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Flags de negocio que deben quedar explícitamente en false en producción ---
SUPERADMIN_CAN_DELETE=false

# Igual que en desarrollo (ver .env.example): expiración fija de Sanctum +
# inactividad de 30 min ya están en el código, no dependen de nada acá.
SANCTUM_TOKEN_EXPIRATION_MINUTES=20160
